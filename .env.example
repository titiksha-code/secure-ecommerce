# =============================================================================
# SecureCart Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit real credentials to version control.
# =============================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securecart_db
DB_USERNAME=root
DB_PASSWORD=rootpassword
SPRING_PROFILES_ACTIVE=dev

# Initial Administrator Seed Credentials (Used only on initial startup if not present)
APP_ADMIN_EMAIL=admin@securecart.com
APP_ADMIN_PASSWORD=AdminSecure@2026!
APP_ADMIN_FIRST_NAME=System
APP_ADMIN_LAST_NAME=Administrator

# Security & JWT Secrets
# Secret must be at least 256 bits (32 bytes) hex or base64 encoded
JWT_SECRET=4c5970337336763979244226452948404d635166546a576e5a72347537782141
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=SecureCart
JWT_AUDIENCE=SecureCart-App

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Config
VITE_API_BASE_URL=/api/v1
